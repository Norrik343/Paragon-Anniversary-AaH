<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<Script file="ParagonExpBar.lua"/>

	<!--
		Paragon Experience Bar

		Default UI: sits in the experience bar slot at the top of MainMenuBar
		(where the normal XP bar is while levelling). A watched reputation stacks
		above it, the same way it stacks above the XP bar while levelling.

		ElvUI: ParagonExpBar.lua re-parents the bar to UIParent, gives it the
		ElvUI look and registers a mover (/moveui) for it.

		All positioning is done in ParagonExpBar.lua.
	-->
	<Frame name="ParagonExpBar" enableMouse="true" parent="MainMenuBar" hidden="true">
		<Size>
			<AbsDimension x="1024" y="13"/>
		</Size>
		<Anchors>
			<Anchor point="TOP" relativeTo="MainMenuBar" relativePoint="TOP"/>
		</Anchors>

		<Frames>
			<StatusBar name="$parentStatusBar" parentKey="StatusBar" minValue="0" maxValue="100" defaultValue="0">
				<Anchors>
					<Anchor point="TOPLEFT"/>
					<Anchor point="BOTTOMRIGHT"/>
				</Anchors>

				<Layers>
					<Layer level="BACKGROUND">
						<Texture name="$parentBackground">
							<Anchors>
								<Anchor point="TOPLEFT"/>
								<Anchor point="BOTTOMRIGHT"/>
							</Anchors>
							<Color r="0" g="0" b="0" a="0.5"/>
						</Texture>
					</Layer>
					<Layer level="OVERLAY">
						<!-- Same divider art as the default XP bar (MainMenuXPBarTexture0-3) -->
						<Texture name="$parentTexture0" file="Interface\MainMenuBar\UI-MainMenuBar-Dwarf">
							<Size>
								<AbsDimension x="256" y="10"/>
							</Size>
							<Anchors>
								<Anchor point="BOTTOM">
									<Offset>
										<AbsDimension x="-384" y="3"/>
									</Offset>
								</Anchor>
							</Anchors>
							<TexCoords left="0" right="1.0" top="0.79296875" bottom="0.83203125"/>
						</Texture>
						<Texture name="$parentTexture1" file="Interface\MainMenuBar\UI-MainMenuBar-Dwarf">
							<Size>
								<AbsDimension x="256" y="10"/>
							</Size>
							<Anchors>
								<Anchor point="BOTTOM">
									<Offset>
										<AbsDimension x="-128" y="3"/>
									</Offset>
								</Anchor>
							</Anchors>
							<TexCoords left="0" right="1.0" top="0.54296875" bottom="0.58203125"/>
						</Texture>
						<Texture name="$parentTexture2" file="Interface\MainMenuBar\UI-MainMenuBar-Dwarf">
							<Size>
								<AbsDimension x="256" y="10"/>
							</Size>
							<Anchors>
								<Anchor point="BOTTOM">
									<Offset>
										<AbsDimension x="128" y="3"/>
									</Offset>
								</Anchor>
							</Anchors>
							<TexCoords left="0" right="1.0" top="0.29296875" bottom="0.33203125"/>
						</Texture>
						<Texture name="$parentTexture3" file="Interface\MainMenuBar\UI-MainMenuBar-Dwarf">
							<Size>
								<AbsDimension x="256" y="10"/>
							</Size>
							<Anchors>
								<Anchor point="BOTTOM">
									<Offset>
										<AbsDimension x="384" y="3"/>
									</Offset>
								</Anchor>
							</Anchors>
							<TexCoords left="0" right="1.0" top="0.04296875" bottom="0.08203125"/>
						</Texture>
					</Layer>
				</Layers>

				<BarTexture file="Interface\TargetingFrame\UI-StatusBar"/>
				<BarColor r="0.90" g="0.80" b="0.50"/>
			</StatusBar>

			<!-- Overlay frame for text -->
			<Frame name="$parentOverlayFrame">
				<Anchors>
					<Anchor point="TOPLEFT"/>
					<Anchor point="BOTTOMRIGHT"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString name="$parentText" inherits="TextStatusBarText">
							<Anchors>
								<Anchor point="CENTER">
									<Offset>
										<AbsDimension x="0" y="1"/>
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
		</Frames>

		<Scripts>
			<OnLoad>
				ParagonExpBar_OnLoad(self);
			</OnLoad>
			<OnEvent>
				ParagonExpBar_OnEvent(self, event, ...);
			</OnEvent>
			<OnShow>
				ParagonExpBar_UpdateText();
			</OnShow>
			<OnEnter>
				ParagonExpBar_OnEnter(self);
			</OnEnter>
			<OnLeave>
				ParagonExpBar_OnLeave(self);
			</OnLeave>
		</Scripts>
	</Frame>
</Ui>
